{{ 'bundle-tiers.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Marketing view of the pack ladder. Each tier points at a variant, so the
  prices shown are the real ones rather than hand-typed copy.
{%- endcomment -%}

<section class="section tiers">
  <div class="container">
    <div class="section-head section-head--center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display-3">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p>{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <ul class="tiers__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign tier_product = block.settings.product | default: product -%}
        {%- assign variant = nil -%}

        {%- for candidate in tier_product.variants -%}
          {%- if candidate.title == block.settings.variant_title -%}
            {%- assign variant = candidate -%}
          {%- endif -%}
        {%- endfor -%}

        <li class="tier reveal{% if block.settings.featured %} tier--featured{% endif %}">
          {%- if block.settings.featured and block.settings.badge != blank -%}
            <span class="tier__badge">{{ block.settings.badge }}</span>
          {%- endif -%}

          <h3 class="tier__title">{{ block.settings.title }}</h3>
          <p class="tier__meta">{{ block.settings.meta }}</p>

          {%- if variant -%}
            <p class="tier__price">
              {% render 'price', price: variant.price, compare_at: variant.compare_at_price %}
            </p>
          {%- else -%}
            <p class="tier__price tier__price--missing">Set this tier in the theme editor</p>
          {%- endif -%}

          {%- if block.settings.note != blank -%}
            <p class="tier__note">{{ block.settings.note }}</p>
          {%- endif -%}

          {%- if variant -%}
            <a class="btn btn--primary btn--block" href="{{ tier_product.url }}?variant={{ variant.id }}">
              <span>{{ block.settings.cta | default: 'Choose' }}</span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.cta_text != blank -%}
      <div class="section-foot section-foot--center">
        <a class="btn btn--ghost" href="{{ section.settings.cta_link }}">
          <span>{{ section.settings.cta_text }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bundle tiers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stock up" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy one tin, or stock up" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The more tins you take, the less each one costs. Subscriptions save the most."
    },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Build a mixed box" },
    { "type": "url", "id": "cta_link", "label": "Button link", "default": "/pages/build-a-box" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Leave blank on a product page to use the product being viewed."
        },
        {
          "type": "text",
          "id": "variant_title",
          "label": "Variant title",
          "info": "Must match the variant exactly, for example \"3-Pack\".",
          "default": "1 Tin"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "1 Tin" },
        { "type": "text", "id": "meta", "label": "Meta", "default": "18 pouches" },
        { "type": "text", "id": "note", "label": "Note" },
        { "type": "text", "id": "cta", "label": "Button", "default": "Choose" },
        { "type": "checkbox", "id": "featured", "label": "Featured", "default": false },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Most popular" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": { "variant_title": "1 Tin", "title": "1 Tin", "meta": "18 pouches" }
        },
        {
          "type": "tier",
          "settings": {
            "variant_title": "3-Pack",
            "title": "3-Pack",
            "meta": "54 pouches",
            "note": "Our starter run"
          }
        },
        {
          "type": "tier",
          "settings": {
            "variant_title": "6-Pack",
            "title": "6-Pack",
            "meta": "108 pouches",
            "featured": true,
            "badge": "Best value"
          }
        }
      ]
    }
  ]
}
{% endschema %}
