{{ 'how-it-works.css' | asset_url | stylesheet_tag }}

<section class="section how{% if section.settings.layout == 'detailed' %} how--detailed{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="display-3">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <p>{{ section.settings.body }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="how__steps" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          {%- assign step_image = block.settings.image | image_url: width: 1200 -%}
        {%- elsif block.settings.image_asset != blank -%}
          {%- assign step_image = block.settings.image_asset | asset_url -%}
        {%- else -%}
          {%- assign step_image = nil -%}
        {%- endif -%}

        <li class="how__step reveal">
          <div class="how__media media-fill">
            {%- if step_image -%}
              <img
                src="{{ step_image }}"
                alt="{{ block.settings.image_alt | escape }}"
                width="1152"
                height="864"
                loading="lazy"
              >
            {%- endif -%}
            <span class="how__num" aria-hidden="true">{{ forloop.index }}</span>
          </div>

          <div class="how__body">
            <h3 class="how__title">{{ block.settings.title }}</h3>
            <p class="how__lead">{{ block.settings.summary }}</p>
            {%- if section.settings.layout == 'detailed' and block.settings.detail != blank -%}
              <p class="how__detail">{{ block.settings.detail }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "compact", "label": "Compact (3 across)" },
        { "value": "detailed", "label": "Detailed (alternating rows)" }
      ],
      "default": "compact"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three steps" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How MOVO Boost works" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "No shaker. No bottle. No waiting for powder to dissolve. Open the tin and go."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pop it in" },
        {
          "type": "text",
          "id": "summary",
          "label": "Summary",
          "default": "Place one pouch between lip and gum."
        },
        { "type": "textarea", "id": "detail", "label": "Detail" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback image (theme asset filename)"
        },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Pop it in",
            "summary": "Place one pouch between lip and gum.",
            "detail": "Either side, upper or lower \u2014 wherever it sits comfortably. You\u2019ll feel a light tingle as it settles. That\u2019s the pouch starting to release.",
            "image_asset": "step-pop-it-in.jpg",
            "image_alt": "A person holding a MOVO Boost pouch up to their mouth"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Keep moving",
            "summary": "No mixing, shaker, or bottle.",
            "detail": "Leave it in while you train, drive, travel or work. Hands stay free and there is nothing to clean up afterwards.",
            "image_asset": "step-keep-moving.jpg",
            "image_alt": "A runner mid-stride on a sunlit path"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Hydrate anywhere",
            "summary": "Electrolytes wherever you go.",
            "detail": "When you\u2019re done, throw the used pouch away \u2014 don\u2019t swallow it. The tin holds 18 and fits in a pocket, so the next one is always on you.",
            "image_asset": "step-hydrate-anywhere.jpg",
            "image_alt": "A MOVO Boost tin being slipped into a trouser pocket"
          }
        }
      ]
    }
  ]
}
{% endschema %}
