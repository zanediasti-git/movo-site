{{ 'page-hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Standard page masthead. Falls back to the page title so a new page looks
  right before anyone fills the section in.
{%- endcomment -%}

{%- if section.settings.image != blank -%}
  {%- assign hero_image = section.settings.image | image_url: width: 2000 -%}
{%- elsif section.settings.image_asset != blank -%}
  {%- assign hero_image = section.settings.image_asset | asset_url -%}
{%- endif -%}

<section
  class="phero{% if hero_image %} phero--image{% endif %}"
  data-flavor="{{ section.settings.accent }}"
>
  {%- if hero_image -%}
    <div class="phero__bg media-fill media-duotone">
      <img src="{{ hero_image }}" alt="" width="1600" height="700">
    </div>
  {%- endif -%}

  <span class="streaks" aria-hidden="true"></span>

  <div class="container phero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="display-2">{{ section.settings.heading | default: page.title }}</h1>

    {%- if section.settings.lede != blank -%}
      <p class="lede phero__lede">{{ section.settings.lede }}</p>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="section-foot">
        <a class="btn btn--primary" href="{{ section.settings.cta_link }}">
          <span>{{ section.settings.cta_text }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    {
      "type": "select",
      "id": "accent",
      "label": "Accent",
      "options": [
        { "value": "brand", "label": "Brand blue" },
        { "value": "volt", "label": "Volt" },
        { "value": "mint", "label": "Mint" },
        { "value": "citrus", "label": "Citrus" }
      ],
      "default": "brand"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "cta_text", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Background photo" },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fallback background (theme asset filename)"
    }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
