{{ 'zero-bar.css' | asset_url | stylesheet_tag }}

<section class="section zero-bar">
  <div class="container zero-bar__inner">
    <div class="zero-bar__copy reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display-2">{{ section.settings.heading }}</h2>
      <p class="lede">{{ section.settings.body }}</p>
    </div>

    <ul class="zero-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="zero reveal">
          <span class="zero__num">0</span>
          <span class="zero__label">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Zero bar",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What it is, and isn\u2019t" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The pouch, rebuilt for hydration."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "We took the most convenient format there is and filled it with electrolytes instead. Nothing else comes along for the ride."
    }
  ],
  "blocks": [
    {
      "type": "zero",
      "name": "Zero claim",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Sugar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zero bar",
      "blocks": [
        { "type": "zero", "settings": { "label": "Nicotine" } },
        { "type": "zero", "settings": { "label": "Caffeine" } },
        { "type": "zero", "settings": { "label": "Sugar" } }
      ]
    }
  ]
}
{% endschema %}
