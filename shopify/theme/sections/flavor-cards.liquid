{{ 'product-card.css' | asset_url | stylesheet_tag }}

{%- assign source = section.settings.collection -%}

<section class="section flavor-cards">
  <div class="container">
    <div class="section-head section-head--center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="display-3">{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p>{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    {%- if source.products.size > 0 -%}
      <ul class="pcards" role="list">
        {%- for product in source.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="flavor-cards__empty">
        Pick a collection for this section in the theme editor.
      </p>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="section-foot section-foot--center">
        <a class="btn btn--ghost" href="{{ section.settings.cta_link }}">
          <span>{{ section.settings.cta_text }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Flavor cards",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "default": "pouches" },
    {
      "type": "range",
      "id": "limit",
      "label": "Products shown",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two flavors at launch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your flavor" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Same formula in both. Choose on taste alone."
    },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Build a mixed box" },
    { "type": "url", "id": "cta_link", "label": "Button link", "default": "/pages/build-a-box" }
  ],
  "presets": [{ "name": "Flavor cards" }]
}
{% endschema %}
