{{ 'faq.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Native <details> elements, so the FAQ works with JavaScript disabled.
  faq.js only adds the "close the others" behavior.
{%- endcomment -%}

<section class="section faq">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="section-head reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="display-3">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="faq__list" data-faq{% if section.settings.exclusive %} data-faq-exclusive{% endif %}>
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          <h3 class="faq__group">{{ block.settings.title }}</h3>
        {%- else -%}
          <details class="faq__item">
            <summary class="faq__q">
              <span>{{ block.settings.question }}</span>
              {% render 'icon', name: 'plus' %}
            </summary>
            <div class="faq__a">
              {{ block.settings.answer }}
              {%- if block.settings.show_allergen and settings.allergen_warning != blank -%}
                <div class="notice">
                  <span class="notice__icon" aria-hidden="true">&#9888;</span>
                  {{ settings.allergen_warning }}
                </div>
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footer != blank -%}
      <div class="faq__footer">{{ section.settings.footer }}</div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'faq.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "Close other answers when one opens",
      "default": true
    },
    { "type": "richtext", "id": "footer", "label": "Footer note" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Group heading",
      "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "The basics" }]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is MOVO Boost?" },
        { "type": "richtext", "id": "answer", "label": "Answer" },
        {
          "type": "checkbox",
          "id": "show_allergen",
          "label": "Append the xylitol warning",
          "default": false
        }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
