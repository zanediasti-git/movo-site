{{ 'hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Images resolve from the theme editor first, then fall back to the photography
  that ships in assets/. That keeps the section looking right on a fresh install
  before anyone has uploaded anything.
{%- endcomment -%}

{%- if section.settings.background != blank -%}
  {%- assign hero_bg = section.settings.background | image_url: width: 2000 -%}
{%- elsif section.settings.background_asset != blank -%}
  {%- assign hero_bg = section.settings.background_asset | asset_url -%}
{%- endif -%}

{%- if section.settings.product_image != blank -%}
  {%- assign hero_product = section.settings.product_image | image_url: width: 1200 -%}
{%- elsif section.settings.product_asset != blank -%}
  {%- assign hero_product = section.settings.product_asset | asset_url -%}
{%- endif -%}

<section class="hero" data-flavor="{{ section.settings.accent }}">
  {%- if hero_bg -%}
    <div class="hero__bg media-fill media-duotone">
      <img src="{{ hero_bg }}" alt="" width="1600" height="1000" fetchpriority="high">
    </div>
  {%- endif -%}

  <span class="streaks" aria-hidden="true"></span>

  <div class="container hero__inner">
    <div class="hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="display-1 hero__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="hero__title-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h1>

      <p class="lede hero__lede">{{ section.settings.subheading }}</p>

      <div class="hero__cta">
        <a class="btn btn--primary btn--lg" href="{{ section.settings.cta_link }}">
          <span>{{ section.settings.cta_text }}</span>
        </a>
        {%- if section.settings.cta2_text != blank -%}
          <a class="btn btn--ghost btn--lg" href="{{ section.settings.cta2_link }}">
            <span>{{ section.settings.cta2_text }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="hero__trust" role="list">
          {%- for block in section.blocks -%}
            <li class="hero__trust-item"><span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if hero_product -%}
      <div class="hero__media">
        <img
          src="{{ hero_product }}"
          alt="{{ section.settings.product_image_alt | escape }}"
          width="900"
          height="900"
          fetchpriority="high"
        >
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "accent",
      "label": "Accent",
      "options": [
        { "value": "brand", "label": "Brand blue" },
        { "value": "volt", "label": "Volt" },
        { "value": "mint", "label": "Mint" },
        { "value": "citrus", "label": "Citrus" }
      ],
      "default": "brand"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Electrolyte pouches"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hydration."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, accented line",
      "default": "Without the bottle."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Zero-sugar electrolytes that go where you go. Pop one in and keep moving \u2014 no shaker, no bottle, no waiting for powder to dissolve."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary button",
      "default": "Shop MOVO Boost"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link",
      "default": "/collections/pouches"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Secondary button",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link",
      "default": "/pages/how-it-works"
    },
    { "type": "header", "content": "Imagery" },
    {
      "type": "image_picker",
      "id": "background",
      "label": "Background photo"
    },
    {
      "type": "text",
      "id": "background_asset",
      "label": "Fallback background (theme asset filename)",
      "default": "hero-lifestyle.jpg"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product photo"
    },
    {
      "type": "text",
      "id": "product_asset",
      "label": "Fallback product photo (theme asset filename)",
      "default": "Image-front.jpg"
    },
    {
      "type": "text",
      "id": "product_image_alt",
      "label": "Product photo alt text",
      "default": "An open tin of MOVO Boost pouches with loose pouches beside it"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust marker",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Zero sugar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "trust", "settings": { "text": "18 pouches per tin" } },
        { "type": "trust", "settings": { "text": "Zero sugar" } },
        { "type": "trust", "settings": { "text": "Zero nicotine" } },
        { "type": "trust", "settings": { "text": "Made in Denmark" } }
      ]
    }
  ]
}
{% endschema %}
