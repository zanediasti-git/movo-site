{%- comment -%}
  Progress toward the free shipping threshold set in theme settings.
  Hidden entirely when no threshold is configured.
{%- endcomment -%}

{%- assign threshold = settings.free_shipping_threshold | times: 100 -%}

{%- if threshold > 0 -%}
  {%- assign remaining = threshold | minus: cart.total_price -%}
  {%- if remaining > 0 -%}
    {%- assign percent = cart.total_price | times: 100.0 | divided_by: threshold -%}
  {%- else -%}
    {%- assign percent = 100 -%}
  {%- endif -%}

  <div class="ship-bar">
    <p class="ship-bar__label">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.general.free_shipping_progress' | t: amount: remaining_money }}
      {%- else -%}
        {% render 'icon', name: 'check' %}
        {{ 'cart.general.free_shipping_reached' | t }}
      {%- endif -%}
    </p>
    <div class="ship-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent | round }}">
      <span class="ship-bar__fill" style="width: {{ percent | round }}%"></span>
    </div>
  </div>
{%- endif -%}
