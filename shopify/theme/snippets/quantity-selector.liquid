{%- comment -%}
  Product-form quantity stepper. Shares the .qty styles with the cart lines.
{%- endcomment -%}

<div class="qty" data-qty-selector>
  <button class="qty__btn" type="button" data-qty-step="-1">
    <span class="visually-hidden">{{ 'products.product.decrease_quantity' | t }}</span>
    {% render 'icon', name: 'minus' %}
  </button>

  <input
    class="qty__input"
    type="number"
    name="quantity"
    value="1"
    min="1"
    step="1"
    aria-label="{{ 'products.product.quantity' | t }}"
    data-qty-input
  >

  <button class="qty__btn" type="button" data-qty-step="1">
    <span class="visually-hidden">{{ 'products.product.increase_quantity' | t }}</span>
    {% render 'icon', name: 'plus' %}
  </button>
</div>
