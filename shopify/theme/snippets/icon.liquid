{%- comment -%}
  Inline SVG icons. Usage: {% render 'icon', name: 'cart' %}
  All icons are 24x24, stroked with currentColor so they inherit button color.
{%- endcomment -%}

{%- assign stroke = 'fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"' -%}

<svg class="icon icon--{{ name }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" width="24" height="24">
  {%- case name -%}
    {%- when 'cart' -%}
      <path {{ stroke }} d="M3 4h2.2l2.1 10.6a1.6 1.6 0 0 0 1.6 1.3h8.5a1.6 1.6 0 0 0 1.6-1.3L21 7.5H6" />
      <circle {{ stroke }} cx="9.5" cy="19.5" r="1.4" />
      <circle {{ stroke }} cx="17.5" cy="19.5" r="1.4" />
    {%- when 'menu' -%}
      <path {{ stroke }} d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" />
    {%- when 'close' -%}
      <path {{ stroke }} d="M6 6l12 12M18 6L6 18" />
    {%- when 'search' -%}
      <circle {{ stroke }} cx="10.5" cy="10.5" r="6.5" />
      <path {{ stroke }} d="M15.5 15.5 21 21" />
    {%- when 'plus' -%}
      <path {{ stroke }} d="M12 5v14M5 12h14" />
    {%- when 'minus' -%}
      <path {{ stroke }} d="M5 12h14" />
    {%- when 'check' -%}
      <path {{ stroke }} d="M4.5 12.5l5 5 10-11" />
    {%- when 'dash' -%}
      <path {{ stroke }} d="M6 12h12" />
    {%- when 'chevron-down' -%}
      <path {{ stroke }} d="M6 9.5l6 6 6-6" />
    {%- when 'chevron-right' -%}
      <path {{ stroke }} d="M9.5 6l6 6-6 6" />
    {%- when 'arrow-right' -%}
      <path {{ stroke }} d="M4 12h15M13 6l6 6-6 6" />
    {%- when 'refresh' -%}
      <path {{ stroke }} d="M20 11a8 8 0 1 0-2.4 5.7M20 5v6h-6" />
    {%- when 'bolt' -%}
      <path {{ stroke }} d="M13.5 2.5 5 13.5h5l-1 8 8.5-11h-5z" />
    {%- when 'instagram' -%}
      <rect {{ stroke }} x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle {{ stroke }} cx="12" cy="12" r="3.8" />
      <circle cx="17" cy="7" r="1.1" fill="currentColor" />
    {%- when 'tiktok' -%}
      <path {{ stroke }} d="M14 3.5v10.3a3.6 3.6 0 1 1-3.6-3.6" />
      <path {{ stroke }} d="M14 3.5c.4 2.4 2 4 4.5 4.2" />
    {%- when 'youtube' -%}
      <rect {{ stroke }} x="2.5" y="5.5" width="19" height="13" rx="3.5" />
      <path {{ stroke }} d="M10.5 9.5v5l4.5-2.5z" />
  {%- endcase -%}
</svg>
