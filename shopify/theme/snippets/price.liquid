{%- comment -%}
  Usage: {% render 'price', price: variant.price, compare_at: variant.compare_at_price %}
  Accepts `size` of 'sm' | 'md' | 'lg' and an optional `suffix` label.
{%- endcomment -%}

<span class="price price--{{ size | default: 'md' }}">
  <span class="price__now">{{ price | money }}</span>

  {%- if compare_at and compare_at > price -%}
    <s class="price__was">{{ compare_at | money }}</s>
    {%- assign saved = compare_at | minus: price -%}
    <span class="tag-save"><span>Save {{ saved | money }}</span></span>
  {%- endif -%}

  {%- if suffix != blank -%}
    <span class="price__suffix">{{ suffix }}</span>
  {%- endif -%}
</span>
